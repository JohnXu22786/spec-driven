{
  "name": "keel",
  "version": "1.0.0",
  "description": "龙骨（keel）——规格驱动开发纪律技能包：先立规格、验证假设、防止过度工程、防止范围蔓延。以技能与工具形式约束 agent 行为，为 dsh（DeepSeek Harness）等插件化 harness 提供自包含接入。",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./skills/*": "./skills/*",
    "./templates/*": "./templates/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "skills",
    "templates",
    "docs",
    "examples",
    "tests",
    "README.md",
    "cordis.example.yml",
    "cordis.patch.yml",
    "tsconfig.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh-plugin",
    "spec-driven",
    "spec-first",
    "skill-pack",
    "keel"
  ],
  "engines": {
    "node": ">=22.18.0",
    "dsh": ">=0.1.7-rc.2"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "cli": "node src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  },
  "license": "MIT",
  "author": "JohnXu22786",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JohnXu22786/spec-driven.git"
  },
  "homepage": "https://github.com/JohnXu22786/spec-driven#readme",
  "bugs": {
    "url": "https://github.com/JohnXu22786/spec-driven/issues"
  }
}
